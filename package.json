{
  "name": "data-app-builder",
  "version": "0.1.0",
  "description": "A Looker extension.",
  "main": "dist/bundle.js",
  "scripts": {
    "dev:https": "NODE_ENV=development webpack serve --server-type https --port 8080 --hot --mode development --config webpack.develop.js",
    "build": "NODE_ENV=production webpack --mode production --config webpack.prod.js",
    "dev": "NODE_ENV=development webpack serve --mode development --port 8080 --config webpack.develop.js",
    "lint": "eslint src --ext js,jsx,ts,tsx --fix",
    "format": "prettier --write src",
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "sync-codemode": "bash scripts/sync-codemode.sh",
    "test": "jest && node scripts/test-bundle.mjs"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/__tests__/**/*.test.{js,ts}"
    ]
  },
  "dependencies": {
    "@looker/embed-sdk": "^2.0.10",
    "@looker/extension-sdk": "^25.10.0",
    "@looker/extension-sdk-react": "^25.10.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "5.3.4",
    "swr": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.16",
    "@types/jest": "^30.0.0",
    "@types/react": "^17.0.85",
    "@types/react-dom": "^17.0.26",
    "@types/react-router-dom": "^5.3.3",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^30.5.2",
    "prettier": "^2.8.0",
    "react-refresh": "^0.17.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.8.3",
    "webpack": "^5.67.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0"
  }
}
